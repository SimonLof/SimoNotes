<Window x:Class="SimoNotes.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="420"
        Height="728"
        MinWidth="420"
        MinHeight="728"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock FontSize="20"
                   FontWeight="SemiBold"
                   Text="Settings" />

        <GroupBox Grid.Row="1"
                  Margin="0,14,0,12"
                  Header="Keyboard shortcuts">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock VerticalAlignment="Center"
                           Text="New note" />
                <Button x:Name="NewNoteHotkeyButton"
                        Grid.Column="1"
                        MinWidth="130"
                        Padding="12,6"
                        Click="HotkeyButton_Click" />
                <TextBlock Grid.Row="1"
                           VerticalAlignment="Center"
                           Text="Bring all notes to front" />
                <Button x:Name="BringAllNotesHotkeyButton"
                        Grid.Row="1"
                        Grid.Column="1"
                        MinWidth="130"
                        Padding="12,6"
                        Click="HotkeyButton_Click" />
                <TextBlock x:Name="StatusText"
                           Grid.Row="2"
                           Grid.ColumnSpan="2"
                           Margin="0,8,0,0"
                           Foreground="#FF9A3D2F"
                           TextWrapping="Wrap" />
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="2"
                  Margin="0,0,0,12"
                  Header="New note defaults">
            <StackPanel Margin="12">
                <TextBlock Margin="0,0,0,6"
                           FontWeight="SemiBold"
                           Text="Style" />
                <ComboBox x:Name="DefaultStyleSelector"
                          Margin="0,0,0,10"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Id"
                          SelectionChanged="DefaultStyleSelector_SelectionChanged" />
                <TextBlock Margin="0,0,0,6"
                           FontWeight="SemiBold"
                           Text="Color" />
                <UniformGrid x:Name="DefaultColorSwatchGrid"
                             Columns="5"
                             HorizontalAlignment="Left" />
                <DockPanel Margin="0,12,0,0">
                    <TextBlock VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Text="Opacity" />
                    <TextBlock x:Name="DefaultOpacityValueText"
                               Margin="8,0,0,0"
                               HorizontalAlignment="Right"
                               DockPanel.Dock="Right"
                               VerticalAlignment="Center" />
                </DockPanel>
                <Slider x:Name="DefaultOpacitySlider"
                        Minimum="0.25"
                        Maximum="1"
                        TickFrequency="0.01"
                        IsSnapToTickEnabled="True"
                        ValueChanged="DefaultOpacitySlider_ValueChanged" />
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="3"
                  Header="Other settings">
            <StackPanel Margin="12">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="AutostartButton"
                            MinWidth="150"
                            Margin="0,0,8,0"
                            Padding="10,6"
                            Click="AutostartButton_Click" />
                    <Button MinWidth="150"
                            Padding="10,6"
                            Click="FontLicenseButton_Click"
                            Content="Font credit &amp; license" />
                </StackPanel>
                <TextBlock x:Name="AutostartStatusText"
                           Margin="0,6,0,10"
                           Foreground="#FF777777"
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,8,0,0"
                           Foreground="#FF777777"
                           Text="Press Start 2P by The Press Start 2P Project Authors."
                           TextWrapping="Wrap" />
            </StackPanel>
        </GroupBox>

        <TextBlock Grid.Row="4"
                   Margin="0,12,0,0"
                   Foreground="#FF777777">
            <Run Text="Creator: " />
            <Hyperlink NavigateUri="https://github.com/SimonLof"
                       RequestNavigate="CreatorLink_RequestNavigate">Simon Löfgren</Hyperlink>
        </TextBlock>

        <Grid Grid.Row="5"
              Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button MinWidth="110"
                    Padding="10,6"
                    HorizontalAlignment="Left"
                    Click="ResetSettings_Click"
                    Content="Reset settings" />
            <TextBlock x:Name="NoteCountText"
                       Grid.Column="1"
                       Margin="0,0,12,0"
                       VerticalAlignment="Center"
                       Foreground="#FF777777" />
            <Button Grid.Column="2"
                    MinWidth="125"
                    Padding="10,6"
                    HorizontalAlignment="Right"
                    Foreground="#FF9A3D2F"
                    Click="RemoveAllNotes_Click"
                    Content="Remove all notes" />
        </Grid>

        <Button Grid.Row="6"
                MinWidth="80"
                Margin="0,12,0,0"
                Padding="12,6"
                HorizontalAlignment="Right"
                IsCancel="True"
                Click="CloseButton_Click"
                Content="Close" />
    </Grid>
</Window>