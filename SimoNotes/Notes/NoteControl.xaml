<UserControl x:Class="SimoNotes.Notes.NoteControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="220"
             MinHeight="160"
             RenderTransformOrigin="0,0">
        <Border x:Name="NoteBorder"
            Background="#FFF4B942"
            BorderBrush="#FFB88727"
            BorderThickness="1"
            CornerRadius="3">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="32" />
            </Grid.ColumnDefinitions>

            <Border x:Name="DragSurface"
                    Grid.Row="0"
                    Grid.Column="0"
                    Background="#22FFFFFF"
                    Cursor="SizeAll"
                    MouseLeftButtonDown="DragSurface_MouseLeftButtonDown"
                    MouseLeftButtonUp="DragSurface_MouseLeftButtonUp" />
            <TextBlock x:Name="NoteTitle"
                       Grid.Row="0"
                       Grid.Column="0"
                       Margin="10,0"
                       IsHitTestVisible="False"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Foreground="#FF3B3020"
                       Text="SimoNote" />
                    <Button x:Name="AppearanceButton"
                        Grid.Row="0"
                        Grid.Column="0"
                        Width="24"
                        Height="24"
                        Margin="0,3,4,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="AppearanceButton_Click"
                        ToolTip="Note appearance">
                    <Border x:Name="AppearanceSwatch"
                        Width="18"
                        Height="18"
                        BorderBrush="#FF5B3E18"
                        BorderThickness="1"
                        CornerRadius="2"
                        Background="#FFF4B942" />
                    </Button>
                <Button x:Name="CloseButton"
                    Grid.Row="0"
                    Grid.Column="1"
                    Width="24"
                    Height="24"
                    Margin="0,3,4,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="CloseButton_Click"
                    Content="&#x00D7;"
                    FontSize="16"
                    Foreground="#FF3B3020"
                    ToolTip="Close note" />
            <TextBox x:Name="Editor"
                     Grid.Row="1"
                     Grid.ColumnSpan="2"
                     Margin="10,4,10,12"
                     AcceptsReturn="True"
                     Background="Transparent"
                     BorderThickness="0"
                     FontSize="15"
                     Foreground="#FF30291F"
                     TextChanged="Editor_TextChanged"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" />
            <Thumb x:Name="ResizeThumb"
                   Grid.Row="1"
                   Grid.Column="1"
                   Width="16"
                   Height="16"
                   Margin="0,0,1,1"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Cursor="SizeNWSE"
                   DragDelta="ResizeThumb_DragDelta">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
            <Path Grid.Row="1"
                  Grid.Column="1"
                  Width="10"
                  Height="10"
                  Margin="0,0,4,4"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  Data="M 0,10 L 10,0 M 5,10 L 10,5"
                  IsHitTestVisible="False"
                  Stroke="#99614A20"
                  StrokeThickness="1.5" />

            <Popup x:Name="AppearancePopup"
                   AllowsTransparency="True"
                   Placement="Bottom"
                   PlacementTarget="{Binding ElementName=AppearanceButton}"
                   StaysOpen="False">
                <Border Padding="12"
                        Background="#FFFFFDF7"
                        BorderBrush="#FF8A7653"
                        BorderThickness="1"
                        CornerRadius="3">
                    <StackPanel Width="232">
                        <TextBlock Margin="0,0,0,6"
                                   FontWeight="SemiBold"
                                   Text="Style" />
                        <ComboBox x:Name="StyleSelector"
                                  Margin="0,0,0,10"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  SelectionChanged="StyleSelector_SelectionChanged" />
                        <TextBlock Margin="0,0,0,6"
                                   FontWeight="SemiBold"
                                   Text="Color" />
                        <UniformGrid x:Name="ColorSwatchGrid"
                                     Columns="5" />
                        <DockPanel Margin="0,12,0,0">
                            <TextBlock VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Text="Opacity" />
                            <TextBlock x:Name="OpacityValueText"
                                       Margin="8,0,0,0"
                                       HorizontalAlignment="Right"
                                       DockPanel.Dock="Right"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                        <Slider x:Name="OpacitySlider"
                                Minimum="0.25"
                                Maximum="1"
                                TickFrequency="0.01"
                                IsSnapToTickEnabled="True"
                                ValueChanged="OpacitySlider_ValueChanged" />
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </Border>
</UserControl>