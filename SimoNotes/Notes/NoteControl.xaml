<UserControl x:Class="SimoNotes.Notes.NoteControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="220"
             MinHeight="160">
    <Border Background="#FFF4B942"
            BorderBrush="#FFB88727"
            BorderThickness="1"
            CornerRadius="3">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="32" />
            </Grid.ColumnDefinitions>

            <Thumb x:Name="DragThumb"
                   Grid.Row="0"
                   Grid.Column="0"
                   Background="#22FFFFFF"
                   Cursor="SizeAll">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
            <TextBlock Grid.Row="0"
                       Grid.Column="0"
                       Margin="10,0"
                       IsHitTestVisible="False"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Foreground="#FF3B3020"
                       Text="SimoNote" />
            <Button Grid.Row="0"
                    Grid.Column="1"
                    Width="24"
                    Height="24"
                    Margin="0,3,4,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="CloseButton_Click"
                    Content="&#x00D7;"
                    FontSize="16"
                    Foreground="#FF3B3020"
                    ToolTip="Close note" />
            <TextBox x:Name="Editor"
                     Grid.Row="1"
                     Grid.ColumnSpan="2"
                     Margin="10,4,10,12"
                     AcceptsReturn="True"
                     Background="Transparent"
                     BorderThickness="0"
                     FontSize="15"
                     Foreground="#FF30291F"
                     TextChanged="Editor_TextChanged"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" />
            <Thumb x:Name="ResizeThumb"
                   Grid.Row="1"
                   Grid.Column="1"
                   Width="16"
                   Height="16"
                   Margin="0,0,1,1"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Cursor="SizeNWSE"
                   DragDelta="ResizeThumb_DragDelta">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
            <Path Grid.Row="1"
                  Grid.Column="1"
                  Width="10"
                  Height="10"
                  Margin="0,0,4,4"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  Data="M 0,10 L 10,0 M 5,10 L 10,5"
                  IsHitTestVisible="False"
                  Stroke="#99614A20"
                  StrokeThickness="1.5" />
        </Grid>
    </Border>
</UserControl>